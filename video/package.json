{
  "name": "language-mirror-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "audio": "python3 vo/sfx.py && python3 vo/generate.py && python3 vo/timeline.py && python3 vo/music.py && python3 vo/timeline.py",
    "timeline": "python3 vo/timeline.py",
    "vo": "python3 vo/generate.py && python3 vo/timeline.py",
    "sfx": "python3 vo/sfx.py && python3 vo/timeline.py",
    "words": "python3 vo/words.py",
    "typecheck": "tsc",
    "still": "remotion still Video out/still.png --frame=60",
    "render": "remotion render Video out/video.mp4",
    "rec": "node rec/record.mjs",
    "theme": "node rec/theme.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "^4.0.541",
    "@remotion/paths": "^4.0.541",
    "@types/react": "^19.3.0",
    "playwright": "1.58",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.541",
    "typescript": "^5.9.0",
    "@remotion/fonts": "^4.0.541"
  }
}